<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------------
    # 0. Pass through already rewritten public paths directly
    # ---------------------------------------------------------------
    RewriteRule ^public/ - [L]

    # ---------------------------------------------------------------
    # 0.5 Pass through known root-level static files
    # ---------------------------------------------------------------
    RewriteRule ^(favicon\.ico|robots\.txt|site\.webmanifest)$ public/$1 [L]

    # ---------------------------------------------------------------
    # 1. Block direct access to sensitive backend directories & files
    # ---------------------------------------------------------------
    RewriteRule ^(app|vendor|database|storage|bootstrap)(/|$) - [F,L]

    <FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|\.git|artisan|\.sql|\.log|\.bak)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # ---------------------------------------------------------------
    # 2. Rewrite uploads and assets to the public subfolder
    # ---------------------------------------------------------------
    RewriteRule ^uploads/(.+)$ public/uploads/$1 [L]
    RewriteRule ^assets/(.+)$ public/assets/$1 [L]
    RewriteRule ^storage/(.+)$ public/storage/$1 [L]

    # ---------------------------------------------------------------
    # 3. Pass through real files that exist inside /public
    # ---------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ---------------------------------------------------------------
    # 4. Route all other requests to public/index.php
    # ---------------------------------------------------------------
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# ---------------------------------------------------------------
# MIME Types — Required for modern WebP, SVG & Font delivery
# ---------------------------------------------------------------
<IfModule mod_mime.c>
    AddType font/woff           .woff
    AddType font/woff2          .woff2
    AddType font/ttf            .ttf
    AddType font/otf            .otf
    AddType image/svg+xml       .svg .svgz
    AddType image/webp          .webp
    AddType application/json    .json
    AddType application/pdf     .pdf
</IfModule>

# ---------------------------------------------------------------
# Security Headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------
# Enable Gzip Compression
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE font/woff font/woff2 image/svg+xml
    AddOutputFilterByType DEFLATE text/xml application/xml
</IfModule>

# ---------------------------------------------------------------
# Browser Cache for Static Assets (Images, WebP, Fonts)
# ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/gif              "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/ttf               "access plus 1 year"
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
